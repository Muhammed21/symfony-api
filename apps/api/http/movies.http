@baseUrl = http://localhost:8000
@adminEmail = admin@prime.local
@password = password

### Connexion administrateur (compte des données de test) → 200
# @name loginAdmin
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json

{ "email": "{{adminEmail}}", "password": "{{password}}" }

### Préparer un genre pour les films → 201
# @name createGenreForMovies
POST {{baseUrl}}/genres
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json
Accept: application/json

{ "name": "Policier" }

### Créer un film avec ses genres → 201
# @name createMovie
POST {{baseUrl}}/movies
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Le Parrain",
  "synopsis": "Le patriarche vieillissant d'une dynastie mafieuse transmet le contrôle à son fils.",
  "releaseYear": 1972,
  "duration": 175,
  "ageRating": "16+",
  "genres": [{{createGenreForMovies.response.body.id}}]
}

### Créer un deuxième film, sans synopsis ni genre → 201
POST {{baseUrl}}/movies
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Le Parrain 2",
  "releaseYear": 1974,
  "duration": 202,
  "ageRating": "16+"
}

### Créer un film invalide (titre vide, année trop ancienne, durée nulle, classification inconnue) → 422
POST {{baseUrl}}/movies
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json
Accept: application/json

{
  "title": "",
  "releaseYear": 1800,
  "duration": 0,
  "ageRating": "12+"
}

### Liste par défaut : page 1, 5 films, triés par titre → 200
GET {{baseUrl}}/movies
Accept: application/json

### Page 2, 3 films par page → 200
GET {{baseUrl}}/movies?page=2&limit=3
Accept: application/json

### Filtrer par morceau de titre, sans tenir compte des majuscules → 200
GET {{baseUrl}}/movies?title=PARR
Accept: application/json

### Filtrer par année exacte → 200
GET {{baseUrl}}/movies?year=1974
Accept: application/json

### Cumuler les filtres → 200
GET {{baseUrl}}/movies?title=parrain&year=1974
Accept: application/json

### Filtrer par genre → 200
GET {{baseUrl}}/movies?genre={{createGenreForMovies.response.body.id}}
Accept: application/json

### Cumuler genre et année → 200
GET {{baseUrl}}/movies?genre={{createGenreForMovies.response.body.id}}&year=1972
Accept: application/json

### Genre inexistant : liste vide → 200
GET {{baseUrl}}/movies?genre=999999
Accept: application/json

### Genre invalide → 422
GET {{baseUrl}}/movies?genre=0
Accept: application/json

### Créer un film avec un genre inexistant → 422
POST {{baseUrl}}/movies
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Heat",
  "releaseYear": 1995,
  "duration": 170,
  "ageRating": "16+",
  "genres": [999999]
}

### Page invalide → 422
GET {{baseUrl}}/movies?page=0
Accept: application/json

### Limite trop grande → 422
GET {{baseUrl}}/movies?limit=101
Accept: application/json

### Année qui n'est pas un nombre → 422
GET {{baseUrl}}/movies?year=abc
Accept: application/json

### Détail du film créé, avec son synopsis → 200
GET {{baseUrl}}/movies/{{createMovie.response.body.id}}
Accept: application/json

### Détail d'un film inexistant → 404
GET {{baseUrl}}/movies/999999
Accept: application/json

### Remplacer entièrement le film créé → 200
PUT {{baseUrl}}/movies/{{createMovie.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Le Parrain (version restaurée)",
  "synopsis": "Le patriarche vieillissant d'une dynastie mafieuse transmet le contrôle à son fils.",
  "releaseYear": 1972,
  "duration": 177,
  "ageRating": "16+",
  "genres": []
}

### Remplacer sans champ obligatoire (duration manquante) → 422
PUT {{baseUrl}}/movies/{{createMovie.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Le Parrain",
  "releaseYear": 1972,
  "ageRating": "16+"
}

### Préparer un film à relier (administrateur) → 201
# @name createSimilarMovie
POST {{baseUrl}}/movies
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json
Accept: application/json

{ "title": "Les Affranchis", "releaseYear": 1990, "duration": 146, "ageRating": "16+" }

### Relier deux films comme titres similaires (administrateur) → 204
PUT {{baseUrl}}/movies/{{createMovie.response.body.id}}/similar/{{createSimilarMovie.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.token}}
Accept: application/json

### Les deux films se voient mutuellement dans similarMovies → 200
GET {{baseUrl}}/movies/{{createSimilarMovie.response.body.id}}
Accept: application/json

### Relier à nouveau, dans l'autre sens : aucun doublon → 204
PUT {{baseUrl}}/movies/{{createSimilarMovie.response.body.id}}/similar/{{createMovie.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.token}}
Accept: application/json

### Relier un film à lui-même → 422
PUT {{baseUrl}}/movies/{{createMovie.response.body.id}}/similar/{{createMovie.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.token}}
Accept: application/json

### Relier à un film inexistant → 404
PUT {{baseUrl}}/movies/{{createMovie.response.body.id}}/similar/999999
Authorization: Bearer {{loginAdmin.response.body.token}}
Accept: application/json

### Relier sans être connecté → 401
PUT {{baseUrl}}/movies/{{createMovie.response.body.id}}/similar/{{createSimilarMovie.response.body.id}}
Accept: application/json

### Délier depuis l'autre film : les deux côtés sont déliés → 204
DELETE {{baseUrl}}/movies/{{createSimilarMovie.response.body.id}}/similar/{{createMovie.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.token}}
Accept: application/json

### Supprimer le film créé → 204
DELETE {{baseUrl}}/movies/{{createMovie.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.token}}
Accept: application/json

### Supprimer un film inexistant → 404
DELETE {{baseUrl}}/movies/999999
Authorization: Bearer {{loginAdmin.response.body.token}}
Accept: application/json
