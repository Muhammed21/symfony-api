{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["dist/**"]
    },
    "test": {
      "cache": false
    },
    "lint": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test:integration": {
      "cache": false
    },
    "mutation": {
      "cache": false
    }
  }
}
